<div class="roll-dialog-content">

  <div class="roll-builder">
    <div class="die-selector">
      <label>{{localize "SD.RollDialog.Quantity"}}</label>
      <input type="number" name="quantity" value="{{quantity}}" min="1" max="99" />
    </div>

    <span class="die-separator">×</span>

    <div class="die-type-selector">
      <label>{{localize "SD.RollDialog.DieType"}}</label>
      <div class="die-grid">
        {{#each diceTypes as |dieType|}}
        <label class="die-option {{#if (eq ../die dieType)}}active{{/if}}">
          <input type="radio" name="die" value="{{dieType}}"
                 {{#if (eq ../die dieType)}}checked{{/if}} />
          <span class="die-label">
            <i class="fa {{diceIcon dieType}}"></i>
            {{dieType}}
          </span>
        </label>
        {{/each}}
      </div>
    </div>

    <div class="die-bonus">
      <label>{{localize "SD.RollDialog.Modifier"}}</label>
      <input type="number" name="bonus" value="{{bonus}}" />
    </div>
  </div>

  <div class="situation-bonus">
    <label>{{localize "SD.RollDialog.Situational"}}</label>
    <input type="number" name="situational" value="0" />
  </div>

  <div class="roll-mode-row">
    <label>{{localize "CHAT.RollType"}}</label>
    <select name="rollMode">
      {{!-- rollModes is now an array of {value, label} objects --}}
      {{#each rollModes as |mode|}}
      <option value="{{mode.value}}" {{#if (eq ../currentMode mode.value)}}selected{{/if}}>
        {{mode.label}}
      </option>
      {{/each}}
    </select>
  </div>

  {{#if label}}
  <div class="roll-label">
    <i class="fas fa-dice"></i> <strong>{{label}}</strong>
  </div>
  {{/if}}
</div>
