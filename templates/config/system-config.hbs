<div class="sd system-config-window">
<form class="config-form" autocomplete="off">
  <div class="config-body">
    {{#if isGM}}
    <div class="config-section">
      <h3 class="config-section-title">
        <i class="fas fa-database"></i> Database
        <span class="section-hint">Typed variables shared by Actors, Items, widgets, effects and graphs</span>
        <button type="button" class="config-add-btn" data-action="addDatabaseValue"><i class="fas fa-plus"></i> Add Variable</button>
      </h3>
      <div style="display:grid;grid-template-columns:minmax(130px,1.5fr) minmax(100px,1fr) 100px 90px minmax(90px,1fr) 65px 65px 34px;gap:6px;align-items:center;font-size:10px;color:var(--sd-text-3);padding:0 4px 5px">
        <span>Name</span><span>Variable ID</span><span>Type</span><span>Scope</span><span>Default</span><span>Min</span><span>Max</span><span></span>
      </div>
      {{#each databaseEntries as |v|}}
      <div style="display:grid;grid-template-columns:minmax(130px,1.5fr) minmax(100px,1fr) 100px 90px minmax(90px,1fr) 65px 65px 34px;gap:6px;align-items:center;margin-bottom:6px;padding:6px;border:1px solid var(--sd-border);border-radius:6px;background:var(--sd-bg-2,rgba(255,255,255,.02))">
        <input name="db_{{v.index}}_name" data-db-name="{{v.index}}" value="{{v.name}}" placeholder="Variable name">
        <input data-db-id-preview="{{v.index}}" value="{{v.id}}" readonly title="Generated from the variable name" style="font-family:monospace;color:var(--sd-accent);background:var(--sd-bg);border:1px solid var(--sd-border);border-radius:4px;padding:4px 6px;min-width:0">
        <select name="db_{{v.index}}_type">
          <option value="number" {{#if v.isNumber}}selected{{/if}}>Number</option>
          <option value="integer" {{#if v.isInteger}}selected{{/if}}>Integer</option>
          <option value="text" {{#if v.isText}}selected{{/if}}>Text</option>
          <option value="boolean" {{#if v.isBoolean}}selected{{/if}}>Boolean</option>
          <option value="color" {{#if v.isColor}}selected{{/if}}>Color</option>
          <option value="array" {{#if v.isArray}}selected{{/if}}>Array</option>
          <option value="object" {{#if v.isObject}}selected{{/if}}>Object</option>
        </select>
        <select name="db_{{v.index}}_scope">
          <option value="both" {{#if v.scopeBoth}}selected{{/if}}>Both</option>
          <option value="actor" {{#if v.scopeActor}}selected{{/if}}>Actor</option>
          <option value="item" {{#if v.scopeItem}}selected{{/if}}>Item</option>
        </select>
        {{#if v.isBoolean}}
          <label style="display:flex;align-items:center;gap:5px"><input type="checkbox" name="db_{{v.index}}_initialBool" {{#if v.initial}}checked{{/if}}> Enabled</label>
        {{else}}
          <input name="db_{{v.index}}_initial" value="{{v.initial}}" placeholder="Default">
        {{/if}}
        <input type="number" step="any" name="db_{{v.index}}_min" value="{{v.min}}" {{#unless v.isNumber}}{{#unless v.isInteger}}disabled{{/unless}}{{/unless}}>
        <input type="number" step="any" name="db_{{v.index}}_max" value="{{v.max}}" {{#unless v.isNumber}}{{#unless v.isInteger}}disabled{{/unless}}{{/unless}}>
        <button type="button" class="config-remove-btn" data-action="removeDatabaseValue" data-index="{{v.index}}" title="Remove value"><i class="fas fa-trash"></i></button>
      </div>
      {{/each}}
      <div style="display:flex;justify-content:flex-start;margin:4px 0 2px">
        <button type="button" class="config-add-btn" data-action="addDatabaseValue"><i class="fas fa-plus"></i> Add Variable</button>
      </div>
      {{#unless databaseEntries.length}}
      <div style="padding:18px;text-align:center;color:var(--sd-text-3);font-style:italic;border:1px dashed var(--sd-border);border-radius:6px">Database is empty. Add a typed value; no path is required.</div>
      {{/unless}}
      <p class="section-hint-text"><i class="fas fa-info-circle"></i> Variable ID is generated from the variable name and changes with it. Existing sheet values, widgets, graphs and effects are migrated automatically.</p>
    </div>

    <div class="config-section">
      <h3 class="config-section-title">
        <i class="fas fa-palette"></i> {{localize "SD.Settings.Appearance"}}
        <span class="section-hint">{{localize "SD.Settings.AppearanceHint"}}</span>
      </h3>

      <div class="sd-scheme-grid">
        {{#each schemeEntries as |s|}}
        <button type="button" class="sd-scheme-swatch {{#if s.selected}}is-active{{/if}}"
                data-scheme-id="{{s.id}}" title="{{s.label}}"
                style="--sw-bg:{{s.bg}};--sw-accent:{{s.accent}};--sw-text:{{s.text}}">
          <span class="sd-scheme-preview">
            <span class="sd-scheme-accent"></span>
            <span class="sd-scheme-line"></span>
            <span class="sd-scheme-line short"></span>
          </span>
          <span class="sd-scheme-label">{{s.label}}</span>
          <i class="fas fa-check sd-scheme-check"></i>
        </button>
        {{/each}}
      </div>
      <input type="hidden" name="colorScheme" value="{{currentScheme}}">

      <div class="sd-uiscale-row">
        <label for="uiScaleSlider"><i class="fas fa-text-height"></i> {{localize "SD.Settings.UIScale"}}</label>
        <input type="range" id="uiScaleSlider" name="uiScale" min="50" max="200" step="5" value="{{uiScale}}">
        <output id="uiScaleOutput">{{uiScale}}%</output>
      </div>
    </div>

    <div class="config-section">
      <h3 class="config-section-title">
        <i class="fas fa-diagram-project"></i> Node Graph
        <span class="section-hint">One system graph operating on Database variables</span>
        <button type="button" class="config-add-btn" data-action="editDatabaseGraph"><i class="fas fa-diagram-project"></i> Open Graph{{#if databaseGraph.hasGraph}} ({{databaseGraph.nodeCount}}){{/if}}</button>
      </h3>
      <p class="section-hint-text"><i class="fas fa-info-circle"></i> The graph uses typed variables. Legacy path nodes are compatibility-only and do not appear in the library.</p>
    </div>
    {{else}}
    <div class="config-section"><p>Only the GM can configure the Database and system graph.</p></div>
    {{/if}}
  </div>
  <footer class="config-footer">
    <div class="spacer"></div>
    <button type="button" class="config-btn primary" data-action="saveAndClose"><i class="fas fa-save"></i> Save & Close</button>
  </footer>
</form>
</div>
