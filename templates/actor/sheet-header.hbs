<header class="sheet-header" style="display:flex;align-items:center;gap:12px;padding:10px 14px;background:var(--sd-bg-2);border-bottom:2px solid var(--sd-border);flex-shrink:0">
  <img src="{{actor.img}}" alt="{{actor.name}}"
       data-action="editImage"
       style="width:60px;height:60px;object-fit:cover;border-radius:6px;border:2px solid var(--sd-border);cursor:pointer;flex-shrink:0"/>
  <div style="flex:1;display:flex;flex-direction:column;gap:4px;min-width:0">
    <input class="actor-name" type="text" name="name" value="{{actor.name}}"
           placeholder="Actor name"
           style="font-size:18px;font-weight:700;background:transparent;border:none;border-bottom:1px solid var(--sd-border);color:var(--sd-text);padding:2px 0;width:100%;font-family:inherit"
           {{#unless isEditable}}disabled{{/unless}} />
    <span style="font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--sd-text-3)">{{actor.type}}</span>
  </div>
  <div class="sd-sheet-icon-actions" aria-label="Sheet tools">
    <button type="button" data-action="openBuilder" title="Sheet Builder" aria-label="Sheet Builder"><i class="fas fa-grid-2"></i></button>
    <button type="button" class="sd-sheet-progression-button" data-action="openProgression" title="Progression" aria-label="Progression">
      <i class="fas fa-arrow-trend-up"></i><span class="sd-sheet-level-badge">{{progressionLevel}}</span>
    </button>
    <button type="button" class="sd-sheet-blueprint-button" data-action="openSheetTriggers" title="Sheet Blueprint — all widgets" aria-label="Sheet Blueprint"><i class="fas fa-diagram-project"></i></button>
    <button type="button" data-action="openDatabase" title="Database values" aria-label="Database values"><i class="fas fa-database"></i></button>
    <button type="button" data-action="openInteractions" title="Interactions" aria-label="Interactions"><i class="fas fa-hand-pointer"></i></button>
  </div>
</header>
