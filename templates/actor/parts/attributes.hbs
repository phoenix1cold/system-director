<section class="tab-content" data-group="sheet" data-tab="attributes">

  <div class="section-block attributes-block">
    <h3 class="section-title">{{localize "SD.Attributes"}}</h3>
    <div class="attributes-grid">
      {{#each attributes as |attr|}}
      <div class="attribute-item" data-key="{{attr.key}}">
        <label class="attr-label">{{attr.label}}</label>
        <div class="attr-score">
          <input type="number" name="{{attr.path}}"
                 value="{{attr.value}}" min="1"
                 {{#unless ../isEditable}}disabled{{/unless}} />
        </div>
        <div class="attr-mod" data-action="rollAttribute" data-key="{{attr.key}}"
             title="{{localize 'SD.RollAttributeCheck'}}">
          <span>{{attr.modFormatted}}</span>
        </div>
      </div>
      {{/each}}
    </div>
  </div>

  <div class="section-block combat-block">
    <h3 class="section-title">{{localize "SD.Combat"}}</h3>
    <div class="combat-stats">
      <div class="stat-group">
        <label>{{localize "SD.Defense.Total"}}</label>
        <div class="stat-value large">{{system.defense.total}}</div>
        <div class="stat-sub">
          <input type="number" name="system.defense.armor"
                 value="{{system.defense.armor}}"
                 {{#unless isEditable}}disabled{{/unless}} />
          +
          <input type="number" name="system.defense.bonus"
                 value="{{system.defense.bonus}}"
                 {{#unless isEditable}}disabled{{/unless}} />
        </div>
      </div>
      <div class="stat-group">
        <label>{{localize "SD.Initiative"}}</label>
        <div class="stat-value large">{{signedNumber system.initiative.total}}</div>
        <input type="number" name="system.initiative.bonus"
               value="{{system.initiative.bonus}}"
               {{#unless isEditable}}disabled{{/unless}} />
      </div>
      <div class="stat-group">
        <label>{{localize "SD.Level"}}</label>
        <input type="number" name="system.advancement.level"
               value="{{system.advancement.level}}" min="1"
               class="stat-value large"
               {{#unless isEditable}}disabled{{/unless}} />
      </div>
      <div class="stat-group">
        <label>{{localize "SD.ProficiencyBonus"}}</label>
        <input type="number" name="system.advancement.proficiencyBonus"
               value="{{system.advancement.proficiencyBonus}}"
               class="stat-value large"
               {{#unless isEditable}}disabled{{/unless}} />
      </div>
    </div>

    <div class="movement-block">
      <label class="sub-header">{{localize "SD.Movement"}}</label>
      <div class="movement-grid">
        <span><i class="fas fa-walking"></i>
          <input type="number" name="system.movement.walk" value="{{system.movement.walk}}"
                 {{#unless isEditable}}disabled{{/unless}} />
          {{localize "SD.ft"}}
        </span>
        <span><i class="fas fa-swimmer"></i>
          <input type="number" name="system.movement.swim" value="{{system.movement.swim}}"
                 {{#unless isEditable}}disabled{{/unless}} />
        </span>
        <span><i class="fas fa-feather"></i>
          <input type="number" name="system.movement.fly" value="{{system.movement.fly}}"
                 {{#unless isEditable}}disabled{{/unless}} />
        </span>
        <span><i class="fas fa-mountain"></i>
          <input type="number" name="system.movement.climb" value="{{system.movement.climb}}"
                 {{#unless isEditable}}disabled{{/unless}} />
        </span>
      </div>
    </div>
  </div>

  <div class="section-block xp-block">
    <h3 class="section-title">{{localize "SD.Experience"}}</h3>
    <div class="xp-row">
      <input type="number" name="system.advancement.xp.value"
             value="{{system.advancement.xp.value}}" min="0"
             {{#unless isEditable}}disabled{{/unless}} />
      <span>/</span>
      <input type="number" name="system.advancement.xp.max"
             value="{{system.advancement.xp.max}}" min="0"
             {{#unless isEditable}}disabled{{/unless}} />
      <div class="xp-bar">
        <div class="xp-fill" style="width: {{percent system.advancement.xp.value system.advancement.xp.max}}%;"></div>
      </div>
    </div>
  </div>

  <div class="section-block skills-block">
    <h3 class="section-title">{{localize "SD.Skills"}}</h3>
    <ul class="skills-list">
      {{#each skills as |skill|}}
      <li class="skill-item" data-key="{{skill.key}}">
        <span class="skill-label">{{skill.label}}</span>
        <span class="skill-attr">[{{skill.attributeLabel}}]</span>
        <span class="skill-rank">
          <input type="number" name="{{skill.path}}"
                 value="{{skill.rank}}" min="0"
                 {{#unless ../isEditable}}disabled{{/unless}} />
        </span>
        <span class="skill-bonus" data-action="rollSkill" data-key="{{skill.key}}"
              title="{{localize 'SD.RollSkillCheck'}}">
          {{skill.bonusFormatted}}
        </span>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
