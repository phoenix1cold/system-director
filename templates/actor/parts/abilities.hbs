<section class="tab-content" data-group="sheet" data-tab="abilities" data-drop-zone="abilities">

  <div class="section-controls">
    <button type="button" class="create-btn" data-action="createItem" data-type="ability">
      <i class="fas fa-plus"></i> {{localize "SD.AddAbility"}}
    </button>
    <button type="button" class="create-btn" data-action="createItem" data-type="feature">
      <i class="fas fa-plus"></i> {{localize "SD.AddFeature"}}
    </button>
  </div>

  {{!-- Active Abilities --}}
  {{#if abilities.length}}
  <div class="subsection">
    <h4 class="subsection-title">{{localize "SD.Abilities"}}</h4>
    <ul class="ability-list">
      {{#each abilities as |item|}}
      <li class="ability-row category-{{item.category}}" data-item-id="{{item.id}}">
        <img src="{{item.img}}" class="item-img" alt="{{item.name}}" />
        <span class="item-name">{{item.name}}</span>

        {{#if item.level}}<span class="item-badge level-badge">Lv.{{item.level}}</span>{{/if}}
        {{#if item.activation}}<span class="item-badge activation-badge">{{item.activation}}</span>{{/if}}
        {{#if item.formula}}<span class="item-formula">{{item.formula}}</span>{{/if}}

        {{#if item.usesEnabled}}
        <span class="uses-tracker">{{item.usesValue}}/{{item.usesMax}}</span>
        {{/if}}

        <div class="item-controls">
          {{#if item.hasRoll}}
          <button type="button" class="item-btn" data-action="useItem"
                  title="{{localize 'SD.Use'}}">
            <i class="fas fa-dice"></i>
          </button>
          {{/if}}
          <button type="button" class="item-btn" data-action="editItem">
            <i class="fas fa-edit"></i>
          </button>
          <button type="button" class="item-btn delete-btn" data-action="deleteItem">
            <i class="fas fa-trash"></i>
          </button>
        </div>
      </li>
      {{/each}}
    </ul>
  </div>
  {{/if}}

  {{!-- Features / Traits --}}
  {{#if features.length}}
  <div class="subsection">
    <h4 class="subsection-title">{{localize "SD.Features"}}</h4>
    <ul class="feature-list">
      {{#each features as |item|}}
      <li class="feature-row" data-item-id="{{item.id}}">
        <img src="{{item.img}}" class="item-img" alt="{{item.name}}" />
        <span class="item-name">{{item.name}}</span>
        <span class="item-badge">{{item.category}}</span>
        <div class="item-controls">
          <button type="button" class="item-btn" data-action="editItem"><i class="fas fa-edit"></i></button>
          <button type="button" class="item-btn delete-btn" data-action="deleteItem"><i class="fas fa-trash"></i></button>
        </div>
      </li>
      {{/each}}
    </ul>
  </div>
  {{/if}}

  {{#unless abilities.length}}{{#unless features.length}}
  <div class="empty-list"><i class="fas fa-wand-sparkles"></i> {{localize "SD.NoAbilities"}}</div>
  {{/unless}}{{/unless}}
</section>
